{
	"name": "website",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
		"build": "ng lint && ng build --base-href a",
		"watch": "ng lint && ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"update-all": "npm i baseline-browser-mapping@latest -D --force && npx npm-check-updates -u && npm install --force"
	},
	"private": true,
	"dependencies": {
		"@angular-eslint/builder": "^22.1.0",
		"@angular/animations": "^22.0.6",
		"@angular/common": "^22.0.6",
		"@angular/compiler": "^22.0.6",
		"@angular/core": "^22.0.6",
		"@angular/forms": "^22.0.6",
		"@angular/platform-browser": "^22.0.6",
		"@angular/router": "^22.0.6",
		"@fontsource/noto-color-emoji": "^5.2.12",
		"@jsverse/transloco": "^8.4.0",
		"@primeuix/themes": "^3.0.0",
		"emojibase-data": "^17.0.0",
		"primeicons": "^8.0.0",
		"primeng": "^22.0.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/build": "^22.0.7",
		"@angular/cli": "^22.0.7",
		"@angular/compiler-cli": "^22.0.6",
		"@eslint/js": "^10.0.1",
		"angular-eslint": "22.1.0",
		"baseline-browser-mapping": "^2.10.43",
		"eslint": "^10.7.0",
		"typescript-eslint": "8.64.0"
	}
}
